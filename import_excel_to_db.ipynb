import pandas as pd
import sqlite3
from classes.museum import Museum
from classes.specialty import Specialty
from classes.exhibit import Exhibit
from classes.curator import Curator
from classes.visitors import Visitors

f = 'data/g21_Museums_Exhibits_fv.csv'
db = 'data/database.db'

# Ligar os modelos à DB
modelos = [Museum, Specialty, Exhibit, Curator, Visitors]
for c in modelos:
    c.path = db

# --- 1. APAGAR OS DADOS ANTIGOS (Sem destruir as tabelas) ---
try:
    conn = sqlite3.connect(db)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM Visitors;")
    cursor.execute("DELETE FROM Curator;")
    cursor.execute("DELETE FROM Exhibit;")
    cursor.execute("DELETE FROM Museum;")
    cursor.execute("DELETE FROM Specialty;")
    conn.commit()
    conn.close()
    print("Tabelas antigas limpas! A carregar novos dados...")
except Exception as e:
    print("Aviso:", e)

# --- 2. LER O CSV COM OS NÚMEROS REAIS ---
try:
    df = pd.read_csv(f, sep=None, engine='python', encoding='utf-8-sig')
except:
    df = pd.read_excel(f)

df.columns = [str(c).strip().lower() for c in df.columns]

if 'visitors_number' in df.columns:
    df['visitors_number'] = pd.to_numeric(df['visitors_number'], errors='coerce').fillna(0).astype(int)
else:
    df['visitors_number'] = 0

df = df.fillna('')
# --- 3. INSERIR ESPECIALIDADES ---
for _, row in df[['specialty_id', 'curator_specialty']].drop_duplicates(subset=['specialty_id']).iterrows():
    s_id_str = str(row['specialty_id']).strip()
    if s_id_str != '':
        obj = Specialty(id=int(float(s_id_str)), specialty_name=str(row['curator_specialty']).strip())
        try:
            Specialty.insert(obj.id)
        except AttributeError:
            pass

# --- 4. INSERIR MUSEUS ---
for _, row in df[['museum_id', 'name']].drop_duplicates(subset=['museum_id']).iterrows():
    m_id_str = str(row['museum_id']).strip()
    if m_id_str != '':
        obj = Museum(id=int(float(m_id_str)), name=str(row['name']).strip())
        try:
            Museum.insert(obj.id)
        except AttributeError:
            pass

# --- 5. INSERIR EXPOSIÇÕES ---
for _, row in df[['exhibit_id', 'creation_date', 'title', 'category']].drop_duplicates(subset=['exhibit_id']).iterrows():
    e_id_str = str(row['exhibit_id']).strip()
    if e_id_str != '':
        try:
            dt = pd.to_datetime(str(row['creation_date']).strip()).strftime('%Y-%m-%d')
        except:
            dt = '2024-01-01'
            
        obj = Exhibit(id=int(float(e_id_str)), creation_date=dt, title=str(row['title']).strip(), category=str(row['category']).strip())
        try:
            Exhibit.insert(obj.id)
        except AttributeError:
            pass

# --- 6. INSERIR CURADORES ---
for _, row in df[['curator_id', 'extra_info', 'museum_id', 'specialty_id']].drop_duplicates(subset=['curator_id']).iterrows():
    c_id_str = str(row['curator_id']).strip()
    if c_id_str != '':
        c_id = int(float(c_id_str))
        m_id_str = str(row['museum_id']).strip()
        m_id = int(float(m_id_str)) if m_id_str != '' else 0
        
        s_id_str = str(row['specialty_id']).strip()
        s_id = int(float(s_id_str)) if s_id_str != '' else 0
        
        obj = Curator(id=c_id, extra_info=str(row['extra_info']).strip(), id_museum=m_id, id_specialty=s_id)
        try:
            Curator.insert(obj.id)
        except AttributeError:
            # Ignora o curador se a classe o rejeitar por falta de especialidade válida
            pass

# --- 7. INSERIR VISITANTES ---
v_id = 1
for _, row in df[['exhibit_id', 'museum_id', 'end_date', 'visitors_number']].drop_duplicates().iterrows():
    try:
        dt_v = pd.to_datetime(str(row['end_date']).strip()).strftime('%Y-%m-%d')
    except:
        dt_v = '2024-01-01'
        
    e_id_str = str(row['exhibit_id']).strip()
    e_id = int(float(e_id_str)) if e_id_str != '' else 0
    
    m_id_str = str(row['museum_id']).strip()
    m_id = int(float(m_id_str)) if m_id_str != '' else 0
    
    v_num_str = str(row['visitors_number']).strip()
    v_num = int(float(v_num_str)) if v_num_str != '' else 0
    
    obj = Visitors(id=v_id, id_exhibit=e_id, id_museum=m_id, conclusion_date=dt_v, n_visitors=v_num)
    try:
        Visitors.insert(obj.id)
        v_id += 1
    except AttributeError:
        # Ignora se rejeitado pelas regras de validação
        pass

print(" Sucesso")
